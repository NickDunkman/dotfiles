{
  "model": "sonnet[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nickdunkman/Code/The-Origin-Way/aidev-at-origin/bootstrap/session-start-hook.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "expo-plugins": {
      "source": {
        "source": "github",
        "repo": "expo/skills"
      }
    }
  },
  "allowedTools": [
    {
      "tool": "bash",
      "arguments": {
        "command": "npm info *"
      }
    },
    {
      "tool": "bash",
      "arguments": {
        "command": "npm view *"
      }
    }
  ],
  "advisorModel": "opus"
}
